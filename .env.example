NODE_ENV=development
PORT=5000
# Transactions require a replica set (Atlas or local replica set).
MONGODB_URI=mongodb://127.0.0.1:27017/learnai?replicaSet=rs0
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173
COOKIE_SAME_SITE=lax
# Required for cross-site cookies; always true in production.
COOKIE_SECURE=false
# Number of trusted reverse-proxy hops; leave zero for direct connections.
TRUST_PROXY=0
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Optional: disposable replica-set database for integration tests (will be erased).
TEST_MONGODB_URI=

# Frontend development proxy; server-side Vite setting, never sent to browsers.
API_PROXY_TARGET=http://127.0.0.1:5000
# Browser API prefix; use /api behind a same-origin proxy (recommended).
VITE_API_BASE_URL=/api
