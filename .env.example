# ============================================================
# TeamForge — environment configuration (copy to server/.env)
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
# Option A (recommended): a real MongoDB instance / Atlas cluster
MONGODB_URI=mongodb://127.0.0.1:27017/teamforge
# Option B: leave MONGODB_URI empty and set USE_EMBEDDED_MONGO=1 to run the
# embedded MongoDB-compatible engine that stores data in server/.data/mongo
# (used automatically by tests and by local dev when no URI is configured).
# USE_EMBEDDED_MONGO=1

# --- Auth (REQUIRED — change these!) ---
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_MAX_AGE_MS=604800000

# --- CORS / CSRF ---
# Comma-separated list of frontend origins allowed to call the API with credentials.
# In local dev this is the Vite dev server. In production it is your site origin(s).
CLIENT_URL=http://localhost:5173
# Extra API origins for split deployments (optional). When the frontend is served
# by Express (production single-server setup) you may leave this empty.
CORS_ORIGINS=

# --- Image uploads ---
MAX_UPLOAD_MB=2

# --- Cloudinary image storage ---
# Create an unsigned/standard API-enabled Cloudinary account and set these
# values in server/.env. Image uploads fail explicitly until all are present.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Initial admin (used by `npm run seed:admin`) ---
ADMIN_NAME=Team Admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@teamforge.local
ADMIN_PASSWORD=ChangeMe!123

# --- Frontend (client/.env, optional) ---
# Leave unset in the standard setup: the Vite dev server proxies /api to :5000
# and the production build calls the API with relative URLs (same origin).
# VITE_API_URL=
