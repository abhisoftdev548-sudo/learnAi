# ---------------------------------------------------------------------------
# LearnAI API — environment template. Copy to `server/.env` and fill in.
# Never commit real secrets: `.env` is git-ignored.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
LOG_LEVEL=debug

# Database (a real MongoDB deployment in development and production)
MONGO_URI=mongodb://127.0.0.1:27017/learnai

# Comma separated list of allowed browser origins for CORS
CLIENT_URL=http://localhost:5173,http://localhost:4173

# Authentication — REQUIRED in production (server refuses to start without it)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Auth cookie
COOKIE_NAME=learnai_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE_MS=604800000

# Password hashing cost
BCRYPT_ROUNDS=12

# Rate limiting (set RATE_LIMITS_ENABLED=false to disable in local testing)
RATE_LIMITS_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=40
RATE_LIMIT_SUBMISSION_MAX=60
RATE_LIMIT_API_MAX=600

# Untrusted code execution
#  client-sandbox (default): measurements are collected in a sandboxed client
#                            iframe and judged deterministically on the server.
#  remote-runner:             measurements come from a dedicated isolated service
#                            (see services/execution/remoteRunner.provider.js).
EXECUTION_PROVIDER=client-sandbox
EXECUTION_SERVICE_URL=
EXECUTION_SERVICE_TOKEN=
EXECUTION_TIMEOUT_MS=5000
SANDBOX_TICKET_TTL_MS=3600000

# Request limits
MAX_CODE_SIZE_BYTES=60000

# Seeder credentials (change before sharing an environment)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@learnai.dev
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DEMO_PASSWORD=Practice@123
SEED_DEMO_USERS=6
