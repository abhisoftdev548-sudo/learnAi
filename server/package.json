{
  "name": "teamforge-server",
  "version": "1.0.0",
  "private": true,
  "description": "TeamForge API server — team learning & practice platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node scripts/with-engine.js src/server.js",
    "dev": "node scripts/with-engine.js node_modules/nodemon/bin/nodemon.js --watch src --ext js --exec node src/server.js",
    "seed:admin": "node scripts/with-engine.js src/scripts/seedAdmin.js",
    "prepare:engine": "node scripts/prepare-engine.js",
    "test": "node scripts/with-engine.js node_modules/jest/bin/jest.js --runInBand --forceExit"
  },
  "dependencies": {
    "@0q/embedded-mongodb": "^0.1.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 60000
  },
  "engines": {
    "node": ">=18"
  }
}
