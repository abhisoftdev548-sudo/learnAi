{
  "name": "learnai-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "seed": "node server/seed/index.js",
    "test": "vitest run",
    "test:integration": "RUN_MONGO_TESTS=1 vitest run server/tests/integration.test.js",
    "check": "find server -name '*.js' -print0 | xargs -0 -n1 node --check",
    "db:indexes": "node server/config/indexes.js",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:frontend": "playwright test",
    "dev:server": "node --watch server/server.js",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"frontend-tests/**/*.js\" vite.config.js playwright.config.js",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"frontend-tests/**/*.js\" vite.config.js playwright.config.js"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.1.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.55.0",
    "monaco-editor": "^0.57.0",
    "mongoose": "^8.19.1",
    "postcss": "^8.5.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "mongodb-memory-server": "^10.2.3",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
